# CI/CD secrets — consumed by .github/workflows/ci-cd.yml.
#
# This file documents the secrets the pipeline needs. Copy it to .env
# (gitignored), fill in real values, then run:
#
#   ./scripts/configure-secrets.sh
#
# The script pushes each value into GitHub's encrypted secret store via `gh`
# and enables GitHub Pages. Never commit the real .env — it is gitignored.
# GitHub-hosted runners cannot read this file at runtime; they only see
# repository secrets, which is why this indirection is required.

# GitHub Personal Access Token used by the promote job to open/merge the
# dev-001 -> dev and dev -> main PRs. GITHUB_TOKEN cannot be used because
# PRs it creates do not trigger pull_request workflow runs, so the gate
# checks would never register.
# Scopes: repo, workflow
PROMOTE_TOKEN=

# SonarQube Cloud analysis token. Create at:
#   SonarCloud -> My Account -> Security -> Generate Tokens
# Used by the security_checks job (dev -> main gate) for SCA + quality gate.
SONAR_TOKEN=
