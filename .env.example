# CI/CD secrets and notification settings — consumed by
# .github/workflows/ci-cd.yml and scripts/configure-secrets.sh.
#
# Copy to .env (gitignored), fill in real values, then run:
#
#   ./scripts/configure-secrets.sh
#
# The script pushes each value into GitHub's encrypted secret store via `gh`,
# enables GitHub Pages (Source = GitHub Actions), and registers `dev-001` as a
# deployment branch for the github-pages environment. Never commit the real
# .env — it is gitignored. GitHub-hosted runners cannot read this file at
# runtime; they only see repository secrets.

# ── Tokens ──────────────────────────────────────────────────────────────────

# GitHub PAT used to push release commits from the release job.
# Scopes: repo, workflow
GIT_PUSH_TOKEN=

# GitHub PAT used by the promote job to open/merge the dev-001 → dev and
# dev → main PRs. GITHUB_TOKEN cannot be used because PRs it creates do not
# trigger pull_request workflow runs, so the gate checks would never register.
# Scopes: repo, workflow
PROMOTE_TOKEN=

# SonarQube Cloud analysis token. Create at:
#   SonarCloud → My Account → Security → Generate Tokens
# Used by the security_checks job (dev → main gate) for SCA + quality gate.
# Optional — when absent, the gate runs CodeQL-only SAST.
SONAR_TOKEN=

# ── Notification ────────────────────────────────────────────────────────────
# Deployment notification settings. When NOTIFICATION_ACTIVE is "true", the
# pipeline sends an email to NOTIFICATION_ADDRESS with NOTIFICATION_HEADER as
# the subject upon a successful GitHub Pages deployment.

# Recipient email address for deployment notifications.
NOTIFICATION_ADDRESS=m5stick.testing.mcc@gmail.com

# Email subject header for deployment notifications.
# ${PROJECT_NAME} is expanded by configure-secrets.sh.
PROJECT_NAME=opencode-workflow-demo
NOTIFICATION_HEADER=GitHub - [HKO] ${PROJECT_NAME}

# Set to "true" to enable notifications, "false" to disable.
NOTIFICATION_ACTIVE=false
